# Backend API host. Both the partner and the customer app must point at the
# SAME backend, otherwise changes saved here will not show up for customers.
#
#   Chrome / iOS simulator ......... http://localhost:8000/api
#   Android emulator ............... http://10.0.2.2:8000/api
#   Physical device on Wi-Fi ....... http://<your-machine-LAN-IP>:8000/api
#                                    (start the API with
#                                     `php artisan serve --host=0.0.0.0`)
#
# When this is unset the app falls back to the platform defaults in
# lib/services/api_config.dart.
API_BASE_URL=http://localhost:8000/api

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME="YOUR_CLOUD_NAME"
CLOUDINARY_UPLOAD_PRESET="YOUR_UPLOAD_PRESET"
