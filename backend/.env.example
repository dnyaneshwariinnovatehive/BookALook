APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Push notifications. `log` records every attempted push and contacts nobody;
# it is the driver for every environment until FCM is configured.
#
# To switch to real delivery:
#   PUSH_DRIVER=fcm
#   FCM_PROJECT_ID=your-firebase-project-id
#   FCM_CLIENT_EMAIL=firebase-adminsdk-...@your-project-id.iam.gserviceaccount.com
#   FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# ...or point at a service-account JSON that lives on the server and is never
# committed, which is the better option:
#   FCM_CREDENTIALS_PATH=/etc/bookalook/firebase-service-account.json
#
# Unlike the payment drivers, `fcm` does not fall back to `log` when it is
# unconfigured: it fails loudly and names the variables that are missing, so a
# misconfigured server cannot report every delivery as sent.
#
# The FCM_* values are intentionally absent — add them to .env only once a
# service account exists, and never commit that file.
PUSH_DRIVER=log
# Android channel the notification is posted to. The apps create this channel at
# startup; FCM silently drops a notification whose channel does not exist.
FCM_CHANNEL_ID=bookalook_notifications
# Reminder lead time, in hours. How early the scheduler tells a customer their
# appointment is coming. Set to 0 to switch reminders off without removing the
# schedule.
APPOINTMENT_REMINDER_LEAD_HOURS=3

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
# Two Valkey instances on the VPS (deploy/redis). Passwords are generated on
# the server in /etc/bookalook-redis/secrets — never commit them.
# cache (6379): disposable app cache, allkeys-lru.
REDIS_CACHE_HOST=127.0.0.1
REDIS_CACHE_PORT=6379
REDIS_CACHE_USERNAME=bookalook_app
REDIS_CACHE_PASSWORD=
# state (6380): OTP codes, rate limits, locks. noeviction, AOF + RDB.
REDIS_STATE_HOST=127.0.0.1
REDIS_STATE_PORT=6380
REDIS_STATE_USERNAME=bookalook_app
REDIS_STATE_PASSWORD=
# Keys start "bookalook:{APP_ENV}:" unless REDIS_PREFIX is set.
# Rollback switches (no code change): CACHE_STORE=database moves the app
# cache back to PostgreSQL; STATE_STORE_DRIVER=database together with
# CACHE_LIMITER_STORE=state moves OTPs and rate limits back too.
STATE_STORE_DRIVER=redis
CACHE_LIMITER_STORE=state

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Cloudinary Configuration
CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"

# --- Sign-in ----------------------------------------------------------------
# How long an app login lasts before the person signs in again (minutes;
# default 90 days). SuperAdmin logins always last 12 hours.
SANCTUM_EXPIRATION_MINUTES=129600

# Code used when WhatsApp OTP is switched off. NEVER accepted when
# APP_ENV=production: there, sign-in needs WhatsApp OTP switched on.
OTP_DEMO_CODE=123456

# Sign-in rate limits (defaults shown). IP limits count the address that
# connected to Nginx; no proxy is trusted, so X-Forwarded-For is ignored.
# OTP_SEND_PER_PHONE_10MIN=3
# OTP_SEND_PER_IP_HOUR=20
# OTP_VERIFY_PER_PHONE_10MIN=5
# OTP_VERIFY_PER_IP_HOUR=60

# A fixed sign-in code for Play Store / App Store reviewers, accepted ONLY for
# the numbers listed (comma-separated, e.g. 9000000001,9000000002). These
# numbers are never sent a WhatsApp code. Leave both empty when not in review.
OTP_REVIEW_PHONES=
OTP_REVIEW_CODE=

# --- Customer notifications -------------------------------------------------
# Base for the free-reschedule link sent to customers when a salon closes a day.
CUSTOMER_APP_DEEPLINK_BASE=bookalook://customer

# WhatsApp Business.
#
# `log`        writes each attempt to the log, contacts nobody, and leaves the row
#              `queued` so the outbox can be inspected or drained later.
# `meta_cloud` Meta's own Cloud API, addressed by template name.
# `aisensy`    AISensy, which fronts the same Meta API but addresses sends by the
#              name of a live API campaign instead.
#
# A driver with missing credentials silently falls back to `log`, so a typo in a
# key looks like "nothing is being sent" rather than an error.
WHATSAPP_DRIVER=log

# --- meta_cloud only ---------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# The webhook echoes this back when subscribing, and signs every payload with it.
# Both are used by WhatsAppWebhookController, which parses Meta's payload shape.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- aisensy only ------------------------------------------------------------
# Developer -> API Key in AISensy. Owner-only visibility; rotate by reissuing.
WHATSAPP_AISENSY_API_KEY=
# Overridable so a staging run is labelled separately from live in the dashboard.
WHATSAPP_AISENSY_BASE_URL=https://backend.aisensy.com
WHATSAPP_AISENSY_SOURCE=bookalook

# Assume India for a number typed without a country code.
WHATSAPP_DEFAULT_COUNTRY_CODE=91

# --- Templates and campaigns -------------------------------------------------
# These two groups are keyed by the same events and are meant to be read together.
# `templates` is the Meta template name; `campaigns` is the name of the live
# AISensy API campaign built on that template. A send is described by its event
# and the gateway joins the two.
#
# The campaign name must match the AISensy campaign *exactly*, and that campaign
# must be Live. A blank campaign is a configuration error, reported as a failed
# send naming the variable rather than dropped — see DrainWhatsAppOutbox.
#
# AISensy sends by CAMPAIGN name, not template name. An approved template on its
# own is never sendable; it needs a live API campaign built on top of it.
#
# Setting a template but leaving its campaign blank means the event records a
# failed send every time it fires. That is deliberate and safe — nothing throws,
# and the booking still succeeds — but it does mean an unconfigured event will
# fill the outbox with failures.
#
# --- Template placeholders ---------------------------------------------------
# Each template body must use exactly the placeholders below, in this order and
# this count. AISensy rejects a send whose parameter count does not match the
# template's placeholders, so adding a {{4}} to a body breaks the send even
# though the template itself looks approved.
#
#   booking_confirmed     {{1}} salon name
#                         {{2}} date AND time together ("Sep 26, 2026 at 4:30 PM")
#                         {{3}} advance paid, formatted ("Rs 500.00")
#
#   appointment_reminder  {{1}} salon name
#                         {{2}} date AND time together
#                         {{3}} salon address
#
#   appointment_cancelled {{1}} salon name
#                         {{2}} date AND time together
#                         {{3}} cancellation reason
#
#   salon_closure         {{1}} salon name
#                         {{2}} date AND time together
#                         {{3}} closure reason
#
# {{2}} is one combined label, never a separate date and a separate time.
#
# `bookalook_booking_confirmed2` is the single template being tested. Rename it
# here once the real catalogue is approved.
WHATSAPP_TEMPLATE_BOOKING_CONFIRMED=bookalook_booking_confirmed2
WHATSAPP_TEMPLATE_APPOINTMENT_REMINDER=bookalook_appointment_reminder
WHATSAPP_TEMPLATE_APPOINTMENT_CANCELLED=bookalook_appointment_cancelled
WHATSAPP_TEMPLATE_SALON_CLOSURE=salon_closure_reschedule

WHATSAPP_CAMPAIGN_BOOKING_CONFIRMED=BAL_BOOKING_CONFIRMED
WHATSAPP_CAMPAIGN_APPOINTMENT_REMINDER=
WHATSAPP_CAMPAIGN_APPOINTMENT_CANCELLED=
WHATSAPP_CAMPAIGN_SALON_CLOSURE=

# --- Booking payments -------------------------------------------------------
# No online payment gateway is used. `none` confirms bookings straight away;
# the advance a booking asks for is tracked as due, and the salon (or
# SuperAdmin) records what the customer actually pays. Salon subscriptions and
# commission dues stay on bank transfer with SuperAdmin approval.
#
# A future gateway implements App\Services\Payments\PaymentGateway, adds its
# own driver name here and its keys below, and is bound in AppServiceProvider.
PAYMENT_DRIVER=none
PAYMENT_DISPLAY_NAME=BookALook

# How long a slot stays held while a customer pays online. Only used once a
# gateway is enabled.
BOOKING_PAYMENT_HOLD_MINUTES=10
